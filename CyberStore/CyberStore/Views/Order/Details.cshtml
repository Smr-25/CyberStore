@model CyberStore.Core.Entities.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<section style="padding: 40px 20px; background: #f5f5f5; min-height: 500px;">
    <div style="max-width: 900px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px;">
        <h2 style="margin-bottom: 30px;">Order Details #@Model.Id</h2>

        @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
        {
            <div style="background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div style="margin-bottom: 30px;">
            <h3 style="margin-bottom: 15px;">Order Information</h3>
            <table style="width: 100%; border-collapse: collapse;">
                <tr style="background: #f9f9f9;">
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: bold;">Order Date:</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: bold;">Status:</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">
                        <span style="padding: 4px 8px; border-radius: 4px; background: @GetStatusColor(Model.Status); color: white;">
                            @Model.Status
                        </span>
                    </td>
                </tr>
                <tr style="background: #f9f9f9;">
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: bold;">Customer:</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">@Model.CustomerName (@Model.CustomerEmail)</td>
                </tr>
                <tr>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: bold;">Phone:</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">@Model.PhoneNumber</td>
                </tr>
                <tr style="background: #f9f9f9;">
                    <td style="padding: 10px; border-bottom: 1px solid #ddd; font-weight: bold;">Shipping Address:</td>
                    <td style="padding: 10px; border-bottom: 1px solid #ddd;">@Model.ShippingAddress</td>
                </tr>
            </table>
        </div>

        <div style="margin-bottom: 30px;">
            <h3 style="margin-bottom: 15px;">Order Items</h3>
            <table style="width: 100%; border-collapse: collapse; border: 1px solid #ddd;">
                <thead style="background: #f0f0f0;">
                    <tr>
                        <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ddd;">Product</th>
                        <th style="padding: 12px; text-align: center; border-bottom: 2px solid #ddd;">Quantity</th>
                        <th style="padding: 12px; text-align: right; border-bottom: 2px solid #ddd;">Unit Price</th>
                        <th style="padding: 12px; text-align: right; border-bottom: 2px solid #ddd;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="padding: 12px; border-bottom: 1px solid #ddd;">@item.Product?.Name</td>
                            <td style="padding: 12px; border-bottom: 1px solid #ddd; text-align: center;">@item.Quantity</td>
                            <td style="padding: 12px; border-bottom: 1px solid #ddd; text-align: right;">$@item.UnitPrice.ToString("0.00")</td>
                            <td style="padding: 12px; border-bottom: 1px solid #ddd; text-align: right; font-weight: bold;">$@item.TotalPrice.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="text-align: right; margin-bottom: 30px; font-size: 18px;">
            <strong>Total Amount: $@Model.TotalAmount.ToString("0.00")</strong>
        </div>

        <div style="text-align: center;">
            <a asp-controller="Order" asp-action="History" style="display: inline-block; padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 4px; margin-right: 10px;">Back to Orders</a>
            <a asp-controller="Home" asp-action="Index" style="display: inline-block; padding: 10px 20px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px;">Back to Store</a>
        </div>
    </div>
</section>

@functions {
    private string GetStatusColor(CyberStore.Core.Entities.OrderStatus status)
    {
        return status switch
        {
            CyberStore.Core.Entities.OrderStatus.Pending => "#ffc107",
            CyberStore.Core.Entities.OrderStatus.Processing => "#17a2b8",
            CyberStore.Core.Entities.OrderStatus.Shipped => "#0275d8",
            CyberStore.Core.Entities.OrderStatus.Delivered => "#28a745",
            CyberStore.Core.Entities.OrderStatus.Cancelled => "#dc3545",
            _ => "#6c757d"
        };
    }
}

